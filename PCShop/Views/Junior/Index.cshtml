@model IEnumerable<PCShop.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <table class="table table-striped table-bordered mt-3 align-middle">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Customer Email</th>
                <th>Date</th>
                <th>Order Type</th>
                <th>Current Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id</td>
                        <td>@item.User?.Email</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            @if (item.Type == PCShop.Models.OrderType.Purchase)
                            {
                                <span class="badge bg-primary">Purchase</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Service</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="badge bg-success">@item.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Status</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 m-0">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <select name="newStatus" class="form-select form-select-sm" style="width: auto;">
                                        <option value="">-- Select Status --</option>
                                        <option value="Pending">Pending</option>
                                        <option value="Processing">Processing</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-success">Update</button>
                                </form>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold">View Items</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No orders found in the database.</td>
                </tr>
            }
        </tbody>
    </table>
</div>