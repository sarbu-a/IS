@model PCShop.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <h2>@ViewData["Title"] - #@Model.Id</h2>
    <hr />

    <div class="card mb-4 shadow-sm border-info">
        <div class="card-body">
            <h5 class="card-title fw-bold text-info">Customer Information</h5>
            <p class="mb-1"><strong>Email:</strong> @Model.User?.Email</p>
            <p class="mb-1"><strong>Date Placed:</strong> @Model.CreatedAt.ToLocalTime().ToString("g")</p>
            <p class="mb-1"><strong>Current Status:</strong> <span class="badge bg-secondary">@Model.Status</span></p>
            <p class="mb-0"><strong>Order Type:</strong> @Model.Type</p>
        </div>
    </div>

    <h4>Items in Order</h4>
    <table class="table table-striped table-bordered mt-3 align-middle">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Promo Applied</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-bold">@(item.Product?.Name ?? item.Name)</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>
                            @if (item.IsPromotionDiscount)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">No</span>
                            }
                        </td>
                        <td class="fw-bold text-primary">@((item.Price * item.Quantity).ToString("C"))</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No items found for this order.</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light fw-bold fs-5">
            <tr>
                <td colspan="4" class="text-end">Grand Total:</td>
                <td class="text-success">
                    @(Model.Items != null ? Model.Items.Sum(i => i.Price * i.Quantity).ToString("C") : "0.00 RON")
                </td>
            </tr>
        </tfoot>
    </table>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">← Back to Orders List</a>
    </div>
</div>