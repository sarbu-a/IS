@model IEnumerable<PCShop.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    @if (User.IsInRole("Senior") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-primary mb-4">+ Add New Product</a>
    }

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Product Name</th>
                <th>Category</th>
                <th>Type</th>
                <th>Price</th>
                <th>Promo Status</th>
                @if (User.IsInRole("Senior") || User.IsInRole("Manager"))
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.ComponentType</td>
                        <td>
                            @if (item.HasPromotion && item.OldPrice.HasValue)
                            {
                                <span class="text-muted text-decoration-line-through">@item.OldPrice?.ToString("C")</span>
                                <br />
                                <span class="text-danger fw-bold">@item.Price.ToString("C")</span>
                            }
                            else
                            {
                                <span class="fw-bold">@item.Price.ToString("C")</span>
                            }
                        </td>
                        <td>
                            @if (item.HasPromotion)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">None</span>
                            }
                        </td>
                        @if (User.IsInRole("Senior") || User.IsInRole("Manager"))
                        {
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No products available in the database.</td>
                </tr>
            }
        </tbody>
    </table>
</div>