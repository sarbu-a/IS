@model IEnumerable<PCShop.Models.Product>
@using System.Globalization

@{
    ViewData["Title"] = "Catalog Produse";
    var categories = ViewBag.Categories as List<PCShop.Models.Category>;
    int? selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Catalog Produse</h2>
            <p class="text-muted mb-0">Desktop, Laptop, Imprimante și Periferice</p>
        </div>

        @if (User.IsInRole("Senior") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
        }
    </div>

    <div class="mb-4 d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn @(selectedCategoryId == null ? "btn-dark" : "btn-outline-dark")">
            Toate
        </a>

        @if (categories != null)
        {
            @foreach (var category in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@category.Id"
                   class="btn @(selectedCategoryId == category.Id ? "btn-dark" : "btn-outline-dark")">
                    @category.Name
                </a>
            }
        }
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2 align-self-start">@item.Category?.Name</span>

                            <h5 class="card-title">@item.Name</h5>
                            <p class="text-muted small mb-2">@item.ComponentType</p>

                            <p class="card-text text-muted">
                                @(item.Description.Length > 100
                                    ? item.Description.Substring(0, 100) + "..."
                                    : item.Description)
                            </p>

                            <div class="mb-2">
                                <span class="text-warning fw-semibold">★ @item.Rating</span>
                            </div>

                            <div class="mb-3">
                                @if (item.HasPromotion && item.OldPrice.HasValue)
                                {
                                    <span class="text-muted text-decoration-line-through me-2">
                                        @item.OldPrice?.ToString("N2", CultureInfo.GetCultureInfo("ro-RO")) RON
                                    </span>
                                    <span class="text-danger fw-bold fs-5">
                                        @item.Price.ToString("N2", CultureInfo.GetCultureInfo("ro-RO")) RON
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold fs-5">
                                        @item.Price.ToString("N2", CultureInfo.GetCultureInfo("ro-RO")) RON
                                    </span>
                                }
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100">
                                    Vezi detalii
                                </a>

                                <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" class="btn btn-primary w-100">
                                    Adaugă în coș
                                </a>
                            </div>

                            @if (User.IsInRole("Senior") || User.IsInRole("Manager"))
                            {
                                <div class="mt-3 d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning w-100">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger w-100">Delete</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info mb-0">
                    Nu există produse în această categorie.
                </div>
            </div>
        }
    </div>
</div>