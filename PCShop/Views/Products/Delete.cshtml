@model PCShop.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">
    <h2 class="text-danger">@ViewData["Title"]</h2>
    <h4>Are you sure you want to delete this product?</h4>
    <hr />

    <div class="card shadow-sm col-md-6 mt-3">
        <div class="card-body">
            <h5 class="card-title fw-bold">@Model.Name</h5>
            <p class="card-text text-muted">@Model.Category?.Name - @Model.ComponentType</p>
            
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item"><strong>Price:</strong> @Model.Price.ToString("C")</li>
                <li class="list-group-item"><strong>Rating:</strong> @Model.Rating / 5</li>
                <li class="list-group-item"><strong>Description:</strong> @Model.Description</li>
            </ul>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>