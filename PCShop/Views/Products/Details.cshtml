@model PCShop.Models.Product
@using System.Globalization

@{
    ViewData["Title"] = "Detalii produs";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-12 col-md-6">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm mb-3"
                     style="max-height: 350px; width: 100%; object-fit: cover;" />
            }
            else
            {
                <div class="text-muted">Imagine produs</div>
            }
        </div>

        <div class="col-12 col-md-6">
            <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.ComponentType</p>

            <div class="mb-3">
                <span class="text-warning fw-semibold fs-5">★ @Model.Rating</span>
            </div>

            <p>@Model.Description</p>

            <div class="mb-4">
                @if (Model.HasPromotion && Model.OldPrice.HasValue)
                {
                    <span class="text-muted text-decoration-line-through me-2 fs-5">
                        @Model.OldPrice?.ToString("N2", CultureInfo.GetCultureInfo("ro-RO")) RON
                    </span>
                    <span class="text-danger fw-bold fs-3">
                        @Model.Price.ToString("N2", CultureInfo.GetCultureInfo("ro-RO")) RON
                    </span>
                }
                else
                {
                    <span class="fw-bold fs-3">
                        @Model.Price.ToString("N2", CultureInfo.GetCultureInfo("ro-RO")) RON
                    </span>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" class="btn btn-primary">
                    Adaugă în coș
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Înapoi la catalog
                </a>
            </div>
        </div>
    </div>
</div>