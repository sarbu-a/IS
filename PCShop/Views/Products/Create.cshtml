@model PCShop.Models.Product

@{
    ViewData["Title"] = "Add New Product";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Product Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ComponentType" class="form-label fw-bold">Component Type</label>
                    <input asp-for="ComponentType" class="form-control" placeholder="e.g., Motherboard, GPU" />
                    <span asp-validation-for="ComponentType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold">Price (RON)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Rating" class="form-label fw-bold">Rating</label>
                        <input asp-for="Rating" class="form-control" type="number" step="0.1" max="5" min="0" />
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsAssembledSystem" class="form-check-input" type="checkbox" />
                    <label asp-for="IsAssembledSystem" class="form-check-label fw-bold">Is Assembled System</label>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="HasPromotion" class="form-check-input" type="checkbox" />
                    <label asp-for="HasPromotion" class="form-check-label fw-bold">Has Active Promotion</label>
                </div>

                <button type="submit" class="btn btn-success">Save Product</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}