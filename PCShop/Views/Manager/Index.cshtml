@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <a asp-action="AddEmployee" class="btn btn-primary mb-4">
        + Add New Employee (Junior/Senior)
    </a>

    <h4>Employee List</h4>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Email / Username</th>
                <th>Account ID</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.Id</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">No employees registered.</td>
                </tr>
            }
        </tbody>
    </table>
</div>