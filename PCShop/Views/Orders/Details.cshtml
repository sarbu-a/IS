@model PCShop.Models.Order

@{
    ViewData["Title"] = "Detalii comanda";
}

<div class="container mt-4">
    <h1 class="mb-4">Detalii comanda #@Model.Id</h1>

    <p><strong>Status:</strong> @Model.Status</p>
    <p><strong>Data:</strong> @Model.CreatedAt</p>
    <p><strong>Tip:</strong> @Model.Type</p>

    <table class="table table-striped table-bordered mt-4">
        <thead>
            <tr>
                <th>Produs</th>
                <th>Pret</th>
                <th>Cantitate</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price lei</td>
                    <td>@item.Quantity</td>
                    <td>@(item.Price * item.Quantity) lei</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary mt-3">Inapoi la produse</a>
</div>