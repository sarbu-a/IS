@model IEnumerable<PCShop.Models.ServiceRequest>

@{
    ViewData["Title"] = "Cererile mele";
}

<div class="container mt-4">
    <h1 class="mb-4">Cererile mele de service</h1>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nume contact</th>
                <th>Email</th>
                <th>Telefon</th>
                <th>Descriere problema</th>
                <th>Data predarii</th>
                <th>Status</th>
                <th>Creata la</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ContactName</td>
                    <td>@item.ContactEmail</td>
                    <td>@item.ContactPhone</td>
                    <td>@item.ProblemDescription</td>
                    <td>@item.DropOffDate.ToShortDateString()</td>
                    <td>@item.Status</td>
                    <td>@item.CreatedAt.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
</div>